__pycache__/
*.pyc
.venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# Frozen/live data caches — event-day artifacts, not committed as source
data/raw/
data/frozen/
data/live_cache.json
data/news_cache.json
