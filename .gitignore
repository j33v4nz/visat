.streamlit/secrets.toml
.env
*.key
service-account*.json

# Office lock files (LibreOffice leaves these behind)
.~lock.*#
~$*

# Local debugging/review output (keep out of the repo)
debug.log
*.log
.pytest_temp/
/audit_*.png
/judge_*.png
artifacts/review/*.zip
